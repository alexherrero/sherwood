<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  An example launchd job for sherwood's nightly research run on the Mac.
  Copy it to ~/Library/LaunchAgents/, replace every /PATH/TO/... placeholder
  with a real absolute path (launchd does not expand ~ or $HOME), and load it
  with launchctl bootstrap gui/$(id -u) <the copied file>.

  It runs deploy/mac/research-job.sh at 21:30 local time each night. If the
  Mac is asleep then, launchd runs it when the Mac wakes. A missed night only
  means a stale feed; trading carries on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.sherwood-research</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PATH/TO/sherwood-repo/deploy/mac/research-job.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RESEARCH_DIR</key>
    <string>/PATH/TO/sherwood-research</string>
    <key>CLAUDE</key>
    <string>/PATH/TO/claude</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/PATH/TO/sherwood-research/research-job.log</string>
  <key>StandardErrorPath</key>
  <string>/PATH/TO/sherwood-research/research-job.log</string>
</dict>
</plist>
